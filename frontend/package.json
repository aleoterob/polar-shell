{
  "name": "polarshell-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean:vite": "node -e \"try{require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})}catch(e){}\"",
    "predev": "npm run clean:vite",
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
